# Copy this file to .env and fill in your key.
# The app also works without a key set — it falls back to a clearly
# labeled DEMO STUB response so the security layer (validation, injection
# detection, sanitization) can still be demonstrated end-to-end.

GROQ_API_KEY=your-groq-api-key-here

# Optional — only used if you switch api.py's call_llm() back to Anthropic:
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
